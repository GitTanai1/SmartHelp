# SmartHelp AI Service — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# URL of the Spring Boot backend (used by LangChain tools)
SPRING_BOOT_BASE_URL=http://localhost:8080

# Required only when SMARTHELP_AGENT_TOKEN_REQUIRED=true. The Java core API
# must receive the same value through SMARTHELP_AGENT_SHARED_SECRET.
SMARTHELP_AGENT_SHARED_SECRET=
SMARTHELP_AGENT_TOKEN_REQUIRED=false

# Timeout for Spring Boot API calls in seconds (default: 10)
SPRING_BOOT_TIMEOUT_SECONDS=10

# OpenAI-compatible LLM credentials
# Leave LLM_API_KEY empty to run in deterministic mode (no live LLM calls).
# In deterministic mode the workflow still runs correctly using keyword matching
# and template-based responses. Useful for local development and testing.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini

# Per-call timeout for the LLM client. Retries are bounded to one attempt.
LLM_TIMEOUT_SECONDS=30

# Confidence threshold for automatic resolution (default: 0.70)
# Tickets with confidence below this value are escalated to a human agent.
SMARTHELP_CONFIDENCE_THRESHOLD=0.70

# Durable bounded workflow state. For a deployed runtime, mount this directory
# on persistent storage shared across restarts; do not use ephemeral container
# storage if interrupted agent runs must be resumed.
SMARTHELP_CHECKPOINT_DIR=.runtime/agent-checkpoints
