# SmartHelp AI Service — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# URL of the Spring Boot backend (used by LangChain tools)
SPRING_BOOT_BASE_URL=http://localhost:8080

# Timeout for Spring Boot API calls in seconds (default: 10)
SPRING_BOOT_TIMEOUT_SECONDS=10

# OpenAI-compatible LLM credentials
# Leave LLM_API_KEY empty to run in deterministic mode (no live LLM calls).
# In deterministic mode the workflow still runs correctly using keyword matching
# and template-based responses. Useful for local development and testing.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini

# Confidence threshold for automatic resolution (default: 0.70)
# Tickets with confidence below this value are escalated to a human agent.
SMARTHELP_CONFIDENCE_THRESHOLD=0.70
