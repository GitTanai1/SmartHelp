# ============================================================================
# SmartHelp — environment variable reference
# ============================================================================
# Copy this file to .env for local development.  Never commit .env.
#
# Production deployment targets:
#   Frontend   → Vercel   (set ANGULAR_API_BASE_URL in Vercel project settings)
#   Backend    → Render   (Docker web service, wired via render.yaml)
#   AI service → Render   (Docker web service, wired via render.yaml)
#   Database   → External MySQL — PlanetScale (free) or Aiven (free trial)
#                Render does not offer managed MySQL; only managed PostgreSQL.
#
# Quick-start (local):
#   1. cp .env.example .env
#   2. docker compose up -d mysql   (starts MySQL on port 3306)
#   3. Start the backend once; Flyway applies the versioned schema migrations.
#   4. Optionally load sample data after Flyway completes:
#      Get-Content -Raw backend/src/main/resources/data.sql | docker exec -i smarthelp-mysql mysql -u smarthelp -psmarthelp smarthelp
#   5. Start backend, AI service and frontend — see start-smarthelp.bat
# ============================================================================


# ── MySQL (local Docker via docker-compose) ──────────────────────────────────
MYSQL_ROOT_PASSWORD=smarthelp-root
SMARTHELP_DB_NAME=smarthelp
SMARTHELP_DB_USERNAME=smarthelp
SMARTHELP_DB_PASSWORD=smarthelp
SMARTHELP_DB_PORT=3306


# ── Spring Boot backend ───────────────────────────────────────────────────────

# HTTP port the backend listens on
SERVER_PORT=8080

# Full JDBC connection URL.
# Local:        jdbc:mysql://localhost:3306/smarthelp
# PlanetScale:  jdbc:mysql://aws.connect.psdb.cloud/smarthelp?ssl=true&sslMode=VERIFY_IDENTITY
# Aiven:        jdbc:mysql://<host>:<port>/smarthelp?ssl=true&requireSSL=true
SMARTHELP_DB_URL=jdbc:mysql://localhost:3306/smarthelp

# DB credentials (match MySQL section above for local dev)
# SMARTHELP_DB_USERNAME and SMARTHELP_DB_PASSWORD already set above

# URL of the Python AI service
# Local:  http://localhost:8000
# Render: https://smarthelp-ai.onrender.com  (set automatically by render.yaml)
SMARTHELP_AI_BASE_URL=http://localhost:8000
# Shared internal token used only between the Java API and Python runtime.
# Leave blank for local-open development; production requires a random value.
SMARTHELP_AGENT_SHARED_SECRET=
SMARTHELP_AGENT_TOKEN_REQUIRED=false

# CORS — primary allowed origin for the Angular frontend
# Local:  http://localhost:4200
# Vercel: https://your-frontend.vercel.app  ← fill in after Vercel deploy
SMARTHELP_FRONTEND_ORIGIN=http://localhost:4200

# CORS — optional comma-separated extra allowed origins (Vercel preview URLs etc.)
SMARTHELP_EXTRA_ORIGINS=

# OIDC resource-server integration. Keep false only for local development.
SMARTHELP_OIDC_ENABLED=false
SMARTHELP_OIDC_ISSUER_URI=

# Flyway is the production schema authority. Leave this false for a new database.
# Set it true only for the first startup against a database created before Flyway;
# Flyway records V1 as the baseline and applies later migrations such as V2.
SMARTHELP_FLYWAY_BASELINE_ON_MIGRATE=false


# ── Python AI service ─────────────────────────────────────────────────────────

# URL of the Spring Boot backend (the AI service calls back into it for all data)
# Local:  http://localhost:8080
# Render: https://smarthelp-backend.onrender.com  (set automatically by render.yaml)
SPRING_BOOT_BASE_URL=http://localhost:8080

# HTTP timeout for calls from the AI service to the backend (seconds)
SPRING_BOOT_TIMEOUT_SECONDS=10

# OpenAI-compatible LLM credentials.
# Leave LLM_API_KEY blank to run in deterministic mode (keyword matching +
# template responses — no live LLM calls, good for local dev and free-tier Render).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30

# Confidence threshold for automatic ticket resolution (0.0 – 1.0).
# Tickets scoring below this are escalated to a human agent.
SMARTHELP_CONFIDENCE_THRESHOLD=0.70


# ── Angular frontend (Vercel build-time env var) ──────────────────────────────

# The Spring Boot backend URL injected into the Angular production build.
# Set this in the Vercel project dashboard under Settings → Environment Variables.
# Value must include the /api path suffix.
# Example: https://smarthelp-backend.onrender.com/api
ANGULAR_API_BASE_URL=http://localhost:8080/api/v1
